# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/file_processing
DB_USERNAME=file_processing_user
DB_PASSWORD=file_processing_password

DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=5
DB_CONNECTION_TIMEOUT=30000
DB_VALIDATION_TIMEOUT=5000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000
DB_KEEPALIVE_TIME=300000

# Redis (docker-compose service "redis")
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail (docker-compose service "mailpit" - local SMTP catcher, web UI at :8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@file-processing.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# JWT resource-server bootstrap (dev-only placeholder key so the app can start
# before real Login/JWT issuance exists; generate with:
#   openssl genrsa -out local/jwt/dev-private.pem 2048
#   openssl rsa -in local/jwt/dev-private.pem -pubout -out local/jwt/dev-public.pem
AUTH_JWT_DEV_PUBLIC_KEY_LOCATION=file:local/jwt/dev-public.pem

# Register feature (already have these exact defaults in application.yaml)
AUTH_REGISTER_MAX_PER_HOUR=10
AUTH_EMAIL_VERIFICATION_TOKEN_TTL=PT24H
AUTH_EMAIL_VERIFICATION_BASE_URL=http://localhost:5173/verify-email
AUTH_EMAIL_VERIFICATION_RESEND_MAX_PER_HOUR=10

AUTH_THROTTLE_REDIS_PREFIX=auth:throttle:
AUTH_THROTTLE_REDIS_WINDOW=PT1H

AUTH_EMAIL_VERIFY_TOKEN_PREFIX=auth:email-verify:token:
AUTH_EMAIL_VERIFY_USER_PREFIX=auth:email-verify:user:

AUTH_AMQP_EXCHANGE=auth.events
AUTH_AMQP_ROUTING_AUDIT_LOG=auth.audit-log.recorded
AUTH_AMQP_ROUTING_VERIFY_EMAIL=auth.email.verification-requested
AUTH_AMQP_QUEUE_AUDIT_LOG=auth.audit-log.queue
AUTH_AMQP_QUEUE_VERIFY_EMAIL=auth.email-verification.queue

# RabbitMQ (docker-compose service "rabbitmq")
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq_user
RABBITMQ_PASSWORD=rabbitmq_password

# --- Unused / dead scaffolding, kept for parity - not wired to any bean yet ---
# Generate a local development keypair with docs/superpowers/plans/generate-test-rsa-key.sh.
AUTH_JWT_ISSUER=file-processing
AUTH_JWT_AUDIENCE=file-processing-api
AUTH_JWT_ACTIVE_KID=auth-key-2026-01
AUTH_JWT_PRIVATE_KEY_PEM=
AUTH_JWT_ACTIVE_PUBLIC_KEY_PEM=
AUTH_JWT_ACCESS_TOKEN_TTL=PT15M
AUTH_JWT_PW_CHG_TOKEN_TTL=PT5M
AUTH_JWT_CLOCK_SKEW=PT60S

# Authentication
AUTH_BCRYPT_COST=12
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_USERNAME=
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload
MAX_FILE_SIZE=500MB
MAX_REQUEST_SIZE=500MB

# Hibernate
HIBERNATE_BATCH_SIZE=50
